{
  "name": "room-booking-api",
  "version": "5.0.0",
  "description": "ZTPAI - Room Booking API (Express, PostgreSQL, JWT, testy, Docker, CI)",
  "main": "src/server.js",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "knex migrate:latest",
    "rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "start": "node src/server.js",
    "start:debug": "DEBUG=knex:query node src/server.js",
    "double-booking": "node scripts/double-booking.js",
    "permissions": "node scripts/permissions-matrix.js",
    "register-race": "node scripts/register-race.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit",
    "test:integration": "jest --runInBand tests/integration"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "pg": "^8.16.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
