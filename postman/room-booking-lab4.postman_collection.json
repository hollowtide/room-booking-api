  "item": [
    {
      "name": "0. Zaloguj się (uruchom najpierw)",
      "item": [
        {
          "name": "Logowanie - Jan (USER, właściciel) → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().accessToken;",
                  "pm.collectionVariables.set(\"userToken\", t);",
                  "const [h, p, s] = t.split(\".\");",
                  "const payload = JSON.parse(CryptoJS.enc.Base64.parse(p.replace(/-/g, \"+\").replace(/_/g, \"/\")).toString(CryptoJS.enc.Utf8));",
                  "console.log(\"Payload tokenu Jana:\", JSON.stringify(payload));",
                  "const last = s.slice(-1) === \"A\" ? \"B\" : \"A\";",
                  "pm.collectionVariables.set(\"badSignatureToken\", `${h}.${p}.${s.slice(0, -1)}${last}`);",
                  "payload.role = \"ADMIN\";",
                  "const p2 = CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(JSON.stringify(payload))).replace(/=+$/, \"\").replace(/\\+/g, \"-\").replace(/\\//g, \"_\");",
                  "pm.collectionVariables.set(\"tamperedToken\", `${h}.${p2}.${s}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jan.kowalski@example.com\",\n  \"password\": \"jan-password-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Zapisuje token Jana w zmiennej userToken. Skopiuj accessToken i wklej na jwt.io."
          }
        },
