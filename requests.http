@base = http://localhost:3000/api
# Przed testami: npm run seed

### ===== ZADANIE 1 - rejestracja =====
### 1. Rejestracja (201) - email zapisany małymi literami
POST {{base}}/auth/register
Content-Type: application/json

{ "email": "Jan.Kowalski2@Example.com", "password": "bardzo-dlugie-haslo" }

### 2. Rejestracja z rolą ADMIN (400 - nieznane pole role)
POST {{base}}/auth/register
Content-Type: application/json

{ "email": "haker@example.com", "password": "bardzo-dlugie-haslo", "role": "ADMIN" }

### 3. Za krótkie hasło (400)
POST {{base}}/auth/register
Content-Type: application/json

{ "email": "krotkie@example.com", "password": "krotkie" }

### 4. Duplikat emaila różniący się wielkością liter (409 EMAIL_TAKEN)
POST {{base}}/auth/register
Content-Type: application/json

{ "email": "JAN.KOWALSKI2@EXAMPLE.COM", "password": "bardzo-dlugie-haslo" }

### ===== ZADANIE 2 - logowanie =====
### 5. Logowanie Jana (200) - skopiuj accessToken do @user i wklej na jwt.io
# @name loginUser
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "jan.kowalski@example.com", "password": "jan-password-123" }

### 6. Zły email (401)
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "nikt@example.com", "password": "jan-password-123" }

### 7. Złe hasło (401 - identyczna odpowiedź jak w kroku 6)
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "jan.kowalski@example.com", "password": "zle-haslo-123" }

### 8. Logowanie Anny (USER obcy)
# @name loginAnna
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "anna.nowak@example.com", "password": "anna-password-123" }

### 9. Logowanie admina
# @name loginAdmin
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "admin@example.com", "password": "admin-password-123" }

@user = {{loginUser.response.body.accessToken}}
@anna = {{loginAnna.response.body.accessToken}}
@admin = {{loginAdmin.response.body.accessToken}}

### 10. GET /me (200)
GET {{base}}/auth/me
Authorization: Bearer {{user}}

### ===== ZADANIE 3 - przypadki 401 =====
### 11. Brak nagłówka (401)
GET {{base}}/rooms

### 12. Zły format - Basic (401)
GET {{base}}/rooms
Authorization: Basic YWRtaW46YWRtaW4=

### 13. Bearer bez tokenu (401)
GET {{base}}/rooms
Authorization: Bearer

### 14. Zły podpis - zmień ostatni znak tokenu (401 INVALID_TOKEN)
GET {{base}}/rooms
Authorization: Bearer WKLEJ_TOKEN_Z_ZMIENIONYM_OSTATNIM_ZNAKIEM

### 15. Zmieniony payload (role: ADMIN) z oryginalnym podpisem (401 INVALID_TOKEN)
GET {{base}}/rooms
Authorization: Bearer WKLEJ_TOKEN_Z_PODMIENIONYM_PAYLOADEM

### 16. Wygasły token - serwer z JWT_EXPIRES_IN=10s, odczekaj 10 s (401 TOKEN_EXPIRED)
GET {{base}}/auth/me
Authorization: Bearer WKLEJ_WYGASLY_TOKEN

### 17. Rezerwacja z polem userId w body (400)
POST {{base}}/reservations
Authorization: Bearer {{user}}
Content-Type: application/json

{ "roomId": 3, "participants": 5, "startTime": "2026-12-01T10:00:00Z", "endTime": "2026-12-01T11:00:00Z", "userId": 3 }

### 18. Rezerwacja (201) - user z tokenu, w odpowiedzi user: { id, email }
POST {{base}}/reservations
Authorization: Bearer {{user}}
Content-Type: application/json

{ "roomId": 3, "participants": 5, "startTime": "2026-12-01T10:00:00Z", "endTime": "2026-12-01T11:00:00Z" }

### ===== ZADANIE 4 - role i ownership =====
### 19. USER tworzy budynek (403)
POST {{base}}/buildings
Authorization: Bearer {{user}}
Content-Type: application/json

{ "name": "Budynek X", "address": "ul. Testowa 1" }

### 20. ADMIN tworzy budynek (201)
POST {{base}}/buildings
Authorization: Bearer {{admin}}
Content-Type: application/json

{ "name": "Budynek D", "address": "ul. Nowa 5, Kraków" }

### 21. USER - lista rezerwacji (tylko swoje)
GET {{base}}/reservations
Authorization: Bearer {{user}}

### 22. USER z ?userId=3 (403)
GET {{base}}/reservations?userId=3
Authorization: Bearer {{user}}

### 23. ADMIN - wszystkie rezerwacje, filtr userId=3
GET {{base}}/reservations?userId=3
Authorization: Bearer {{admin}}

### 24. Właściciel - rezerwacja 1 (200)
GET {{base}}/reservations/1
Authorization: Bearer {{user}}

### 25. Obcy USER - rezerwacja 1 (404)
GET {{base}}/reservations/1
Authorization: Bearer {{anna}}

### 26. Obcy USER - anulowanie rezerwacji 1 (404)
PATCH {{base}}/reservations/1/cancel
Authorization: Bearer {{anna}}

### 27. ADMIN - anulowanie rozpoczętej rezerwacji 5 (409 - reguły działają też dla ADMINa)
PATCH {{base}}/reservations/5/cancel
Authorization: Bearer {{admin}}

### 28. ADMIN - usunięcie budynku z salami (409 RESOURCE_IN_USE)
DELETE {{base}}/buildings/1
Authorization: Bearer {{admin}}
